# Runpod — Tiel-Coder-35B-A3B UD-Q4_K_XL 22.4GB (eniewold base)
# Copia a .env y ajusta. En Runpod Console -> Endpoint/Pod -> Settings -> Environment Variables
# Base: https://github.com/eniewold/llama-cpp-runpod (ghcr.io/ggml-org/llama.cpp:server-cuda)
# No incluyas RUNPOD_API_KEY aquí. Usa ~/.secrets/runpod_api_key (ver KEYS.md)

# ── Modelo (eniewold) ───────────────────────────────────────────────
LLAMA_ARG_HF_REPO=peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF
LLAMA_HF_QUANT=UD-Q4_K_XL
# Alternativa: fija GGUF exacto (ignora LLAMA_HF_QUANT si está definido)
# LLAMA_ARG_HF_FILE=Tiel-Coder-35B-A3B-UD-Q4_K_XL.gguf

# ── llama-server (mapean directo a LLAMA_ARG_*) ─────────────────────
LLAMA_ARG_CTX_SIZE=262144
LLAMA_ARG_N_PARALLEL=1          # slots paralelos (contexto se reparte)
LLAMA_ARG_N_GPU_LAYERS=999      # 999 = todos a GPU
LLAMA_ARG_N_CPU_MOE=0           # 0 = expertos en VRAM (poner N si OOM en 24GB)
LLAMA_ARG_FLASH_ATTN=auto
LLAMA_ARG_CACHE_TYPE_K=f16
LLAMA_ARG_CACHE_TYPE_V=f16
# Extra flags verbatim (nunca pongas --port, lo fija start.sh a 3098)
LLAMA_SERVER_CMD_ARGS=

# Para YaRN 1M: añade a LLAMA_SERVER_CMD_ARGS
# --rope-scaling yarn --rope-freq-base 1000000 --yarn-orig-ctx 262144
# y sube LLAMA_ARG_CTX_SIZE=1048576

# ── Hugging Face (opcional) ─────────────────────────────────────────
# HF_TOKEN=hf_...

# ── Aliases legacy greyul ───────────────────────────────────────────
# HF_REPO=peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF
# HF_FILE=Tiel-Coder-35B-A3B-UD-Q4_K_XL.gguf
# MODELS_DIR=/runpod-volume/models
