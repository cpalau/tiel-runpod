# Runpod Serverless - Tiel-Coder-35B-A3B UD-Q4_K_XL (22.4GB)
# Copia a .env y ajusta. En Runpod Console -> Endpoint -> Settings -> Environment Variables

# ── Modelo ──────────────────────────────────────────────────────────
MODEL_URL=https://huggingface.co/peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF/resolve/main/Tiel-Coder-35B-A3B-UD-Q4_K_XL.gguf
MODEL_FILENAME=Tiel-Coder-35B-A3B-UD-Q4_K_XL.gguf
MODEL_DIR=/runpod-volume
MODEL_NAME=Tiel-Coder-35B-A3B-UD-Q4_K_XL

# ── Contexto ────────────────────────────────────────────────────────
# Nativo: 262144 (256k). Para 1M con YaRN: 1048576 + LLAMA_EXTRA_ARGS con --rope-scaling
CONTEXT_LENGTH=262144

# ── llama-server ────────────────────────────────────────────────────
LLAMA_SERVER_PORT=8000
# Flash attention: reduce VRAM ~10-15%, mejora throughput
FLASH_ATTENTION=1
# Split mode: 2 = row (mejor para MoE con 256 expertos)
SPLIT_MODE=2
# Cache quantization: q8_0 ahorra ~30% VRAM vs f16 para KV cache
CACHE_QUANTIZATION=q8_0
# Número máximo de secuencias en paralelo (reduce si OOM)
MAX_NUM_SEQS=4

# ── Extra args para llama-server (separados por espacio) ────────────
# Para 1M con YaRN: --rope-scaling yarn --rope-freq-base 1000000 --yarn-orig-ctx 262144
# Para MoE optimizado: --split-mode 2 --flash-attn
LLAMA_EXTRA_ARGS=--flash-attn --split-mode 2

# ── Hugging Face (opcional, solo si modelo gated) ───────────────────
# HF_TOKEN=hf_...

# ── Runpod ──────────────────────────────────────────────────────────
# No incluyas RUNPOD_API_KEY aquí. Usa ~/.secrets/runpod_api_key