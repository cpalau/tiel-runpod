# Runpod — Tiel-Coder-35B-A3B UD-Q4_K_XL 22.4GB (greyul)
# Copia a .env y ajusta. En Runpod Console -> Endpoint/Pod -> Settings -> Environment Variables
# No incluyas RUNPOD_API_KEY aquí. Usa ~/.secrets/runpod_api_key (ver KEYS.md)

# ── Modelo (greyul) ─────────────────────────────────────────────────
HF_REPO=peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF
HF_FILE=Tiel-Coder-35B-A3B-UD-Q4_K_XL.gguf
MODELS_DIR=/runpod-volume/models

# ── llama-server ────────────────────────────────────────────────────
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080
# Flags mínimos según ficha oficial: -ngl 99 --jinja. No usar --flash-attn (híbrido SSM)
LLAMA_ARGS=-ngl 99 --jinja --context-size 262144
# Para YaRN 1M: -ngl 99 --jinja --context-size 1048576 --rope-scaling yarn --rope-freq-base 1000000 --yarn-orig-ctx 262144

# ── Hugging Face (opcional, solo si modelo gated) ──────────────────
# HF_TOKEN=hf_...

# ── Aliases legacy (compatibilidad archives) ────────────────────────
# MODEL_URL=https://huggingface.co/peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF/resolve/main/Tiel-Coder-35B-A3B-UD-Q4_K_XL.gguf
# MODEL_DIR=/runpod-volume
# CONTEXT_LENGTH=262144
